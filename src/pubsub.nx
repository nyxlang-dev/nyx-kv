// pubsub.nx — Pub/Sub for nyx-kv
// SUBSCRIBE channel: enter subscriber mode, receive messages
// PUBLISH channel message: send to all subscribers, return count
// UNSUBSCRIBE channel: leave subscriber mode
//
// Transporte (Task 2, arco kv↔Redis): cada suscriptor se registra como el
// par [handle, is_tls] — is_tls=0 → handle es un fd TCP crudo, is_tls=1 →
// handle es el SSL handle devuelto por tls_accept. Ambos son `int` en Nyx
// (mismo patrón que std/resp resp_read_framed). Se matchea por AMBOS campos
// al buscar/quitar un suscriptor: un fd de kernel y un SSL handle son
// espacios numéricos DISTINTOS que podrían colisionar en valor.
//
// Modelo de locking: g_pubsub_mtx protege el REGISTRO (Map canal→Array de
// pares), no el I/O del socket. pubsub_publish escribe al handle de OTRA
// conexión bajo ese mutex — ya pasaba así con tcp_write antes de este
// cambio, no es un hazard nuevo. Un suscriptor lento bloquea el fanout
// entero (O(N) síncrono bajo el lock) — limitación heredada, no se resuelve
// acá. Un pubsub_subscriber_loop de un handle nunca comparte el MISMO ssl
// con otro thread (1 conexión TLS = 1 worker), así que no hace falta lock
// de ssl para el I/O propio de esa conexión.

import "std/resp"

var g_pubsub_channels: Map = map_new()
var g_pubsub_mtx: Map = Map.new()
var g_pubsub_init: int = 0

fn pubsub_init() {
    if g_pubsub_init == 1 { return 0 }
    g_pubsub_mtx = mutex_new()
    g_pubsub_init = 1
    return 0
}

// Write al handle correcto según transporte. Top-level (sin closures) para
// no duplicar el branch en subscribe/unsubscribe/publish/subscriber_loop.
fn pubsub_write(handle: int, is_tls: int, msg: String) {
    if is_tls == 1 {
        tls_write_conn(handle, msg)
    } else {
        tcp_write(handle, msg)
    }
}

// Subscribe handle to a channel. Returns RESP subscribe confirmation.
pub fn pubsub_subscribe(handle: int, is_tls: int, channel_name: String) -> String {
    pubsub_init()
    mutex_lock(g_pubsub_mtx)

    if g_pubsub_channels.contains(channel_name) == false {
        let subs: Array = []
        g_pubsub_channels.insert(channel_name, subs)
    }
    let subs: Array = g_pubsub_channels.get(channel_name)

    // Check if already subscribed (match handle AND transport)
    var already: bool = false
    var i: int = 0
    while i < subs.length() {
        let pair: Array = subs[i]
        let h: int = pair[0]
        let t: int = pair[1]
        if h == handle and t == is_tls { already = true }
        i = i + 1
    }
    if already == false {
        subs.push([handle, is_tls])
    }

    mutex_unlock(g_pubsub_mtx)

    // Send subscribe confirmation: *3\r\n$9\r\nsubscribe\r\n$N\r\nchannel\r\n:1\r\n
    var sb: StringBuilder = StringBuilder.new()
    sb.append("*3\r\n$9\r\nsubscribe\r\n$")
    sb.append(int_to_string(channel_name.length()))
    sb.append("\r\n")
    sb.append(channel_name)
    sb.append("\r\n:1\r\n")
    return sb.to_string()
}

// Unsubscribe handle from a channel. Returns RESP unsubscribe confirmation.
pub fn pubsub_unsubscribe(handle: int, is_tls: int, channel_name: String) -> String {
    pubsub_init()
    mutex_lock(g_pubsub_mtx)

    if g_pubsub_channels.contains(channel_name) {
        let subs: Array = g_pubsub_channels.get(channel_name)
        let new_subs: Array = []
        var i: int = 0
        while i < subs.length() {
            let pair: Array = subs[i]
            let h: int = pair[0]
            let t: int = pair[1]
            if h != handle or t != is_tls { new_subs.push(pair) }
            i = i + 1
        }
        g_pubsub_channels.insert(channel_name, new_subs)
    }

    mutex_unlock(g_pubsub_mtx)

    var sb: StringBuilder = StringBuilder.new()
    sb.append("*3\r\n$11\r\nunsubscribe\r\n$")
    sb.append(int_to_string(channel_name.length()))
    sb.append("\r\n")
    sb.append(channel_name)
    sb.append("\r\n:0\r\n")
    return sb.to_string()
}

// Unsubscribe handle from ALL channels (called on disconnect)
pub fn pubsub_disconnect(handle: int, is_tls: int) {
    pubsub_init()
    mutex_lock(g_pubsub_mtx)

    let channels: Array = g_pubsub_channels.keys()
    var ci: int = 0
    while ci < channels.length() {
        let ch: String = channels[ci]
        let subs: Array = g_pubsub_channels.get(ch)
        let new_subs: Array = []
        var i: int = 0
        while i < subs.length() {
            let pair: Array = subs[i]
            let h: int = pair[0]
            let t: int = pair[1]
            if h != handle or t != is_tls { new_subs.push(pair) }
            i = i + 1
        }
        g_pubsub_channels.insert(ch, new_subs)
        ci = ci + 1
    }

    mutex_unlock(g_pubsub_mtx)
}

// Publish a message to a channel. Returns number of subscribers who received it.
pub fn pubsub_publish(channel_name: String, message: String) -> int {
    pubsub_init()
    mutex_lock(g_pubsub_mtx)

    if g_pubsub_channels.contains(channel_name) == false {
        mutex_unlock(g_pubsub_mtx)
        return 0
    }

    let subs: Array = g_pubsub_channels.get(channel_name)
    let count: int = subs.length()

    // Build RESP message: *3\r\n$7\r\nmessage\r\n$N\r\nchannel\r\n$M\r\npayload\r\n
    var sb: StringBuilder = StringBuilder.new()
    sb.append("*3\r\n$7\r\nmessage\r\n$")
    sb.append(int_to_string(channel_name.length()))
    sb.append("\r\n")
    sb.append(channel_name)
    sb.append("\r\n$")
    sb.append(int_to_string(message.length()))
    sb.append("\r\n")
    sb.append(message)
    sb.append("\r\n")
    let msg: String = sb.to_string()

    // Send to all subscribers, branching write by transport
    var i: int = 0
    while i < subs.length() {
        let pair: Array = subs[i]
        let h: int = pair[0]
        let t: int = pair[1]
        pubsub_write(h, t, msg)
        i = i + 1
    }

    mutex_unlock(g_pubsub_mtx)
    return count
}

// Enter subscriber mode: block reading commands, only process SUBSCRIBE/UNSUBSCRIBE/PING
// Returns when client disconnects or sends UNSUBSCRIBE (with no remaining subscriptions)
pub fn pubsub_subscriber_loop(handle: int, is_tls: int) {
    let use_tls: bool = is_tls == 1
    while 1 > 0 {
        let cmd: Array = resp_read_framed(handle, use_tls)
        if cmd.length() == 0 {
            // Client disconnected
            pubsub_disconnect(handle, is_tls)
            return 0
        }

        let raw: String = cmd[0]
        let upper: String = raw.toUpper()

        if upper == "SUBSCRIBE" {
            if cmd.length() >= 2 {
                let ch: String = cmd[1]
                let resp: String = pubsub_subscribe(handle, is_tls, ch)
                pubsub_write(handle, is_tls, resp)
            }
        } else if upper == "UNSUBSCRIBE" {
            if cmd.length() >= 2 {
                let ch: String = cmd[1]
                let resp: String = pubsub_unsubscribe(handle, is_tls, ch)
                pubsub_write(handle, is_tls, resp)
            }
            // Exit subscriber mode
            return 0
        } else if upper == "PING" {
            pubsub_write(handle, is_tls, "+PONG\r\n")
        } else {
            pubsub_write(handle, is_tls, "-ERR only SUBSCRIBE, UNSUBSCRIBE and PING are allowed in subscriber mode\r\n")
        }
    }
    return 0
}
